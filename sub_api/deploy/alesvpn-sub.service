[Unit]
Description=AlesVPN subscription merge API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/alesvpn-app/sub_api
EnvironmentFile=-/var/www/alesvpn-app/sub_api/.env
ExecStart=/var/www/alesvpn-app/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8091
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
