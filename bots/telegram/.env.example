# Токен от @BotFather (только в .env, не коммитить)
BOT_TOKEN=123456789:AA...ваш_токен...

# Через запятую — числовые Telegram user id админов (узнать: @userinfobot)
ADMIN_IDS=123456789

# Цена месяца в боте (СБП / ЮKassa), рубли
PRICE_RUB=75

PRODUCT_TITLE=AlesVPN — 30 дней
# В кавычках — иначе bash: source .env падает на скобках ()
PRODUCT_DESCRIPTION="Доступ к VPN (выдача ключа после оплаты СБП)"

# ЮKassa (те же ключи, что у сайта / pay_api)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# BOT_USERNAME=AlesVPN_bot
# YK_RETURN_URL=https://t.me/AlesVPN_bot

# SQLite-файл с учётом оплат (по умолчанию рядом с рабочей папкой бота)
# DB_PATH=.payments.sqlite

# Юзернейм поддержки в Telegram (без @) — ссылка в /help
# SUPPORT_USERNAME=your_support

# Если с ПК не открывается api.telegram.org — прокси (Clash/v2ray и т.п.)
# TELEGRAM_PROXY=socks5://127.0.0.1:7890

# Таймаут HTTP к api.telegram.org (сек), по умолчанию 120 — при редких Request timeout
# TELEGRAM_HTTP_TIMEOUT=120

# Версия IP до api.telegram.org: v4 (по умолчанию), v6 или auto.
# Проверить, что работает: curl -4 / curl -6 https://api.telegram.org/
# TELEGRAM_IP_FAMILY=v6

# PAYMENT_PROVIDER_TOKEN=

# --- Что выдавать на Android: happ (по умолчанию) или wireguard ---
# happ = тот же Reality-ключ, что на iPhone; WireGuard тогда не нужен
# ANDROID_DELIVERY=happ

# --- Автовыдача WireGuard после оплаты (нужна только при ANDROID_DELIVERY=wireguard) ---
# WG_AUTO_PROVISION=true
# WG_SERVER_PUBLIC_KEY=...
# WG_ENDPOINT=186.246.24.7:51820
# WG_ADD_PEER_SCRIPT=/usr/local/bin/wg-add-peer.sh
# WG_BINARY=wg
# WG_DNS=1.1.1.1
# WG_ALLOWED_IPS=0.0.0.0/1, 128.0.0.0/1
# WG_KEEPALIVE=25
# WG_SUBNET_PREFIX=10.8.0
# WG_OCTET_MIN=20
# WG_OCTET_MAX=250

# --- Автовыдача Happ после оплаты (iPhone и Android при ANDROID_DELIVERY=happ) ---
# HAPP_AUTO_PROVISION=true
#
# PRIMARY = AMS (рекомендуемый NL). Путь панели сверять с `x-ui settings`:
# XUI_BASE_URL=https://129.101.122.146:29292/PATH_AMS
# XUI_API_TOKEN=...
# XUI_INBOUND_ID=1
# XUI_LABEL=ams-nl
#
# SECONDARY = FRA (запасной), тот же subId/uuid пишет бот автоматически:
# XUI2_BASE_URL=http://127.0.0.1:13478/iZBnZ9G1lkZWfscK9b
# XUI2_API_TOKEN=...
# XUI2_INBOUND_ID=1
# XUI2_LABEL=fra-de
#
# Общая HTTPS-подписка (sub_api на AMS за nginx nl.alesvpn.ru):
# XUI_LINK_FORMAT=subscription
# XUI_SUB_BASE_URL=https://nl.alesvpn.ru/s
#
# Пока sub_api не поднят — временно vless только на AMS:
# XUI_LINK_FORMAT=vless
# XUI_PUBLIC_HOST=129.101.122.146
# XUI_PUBLIC_PORT=443
# XUI_PBK=...
# XUI_SID=...
# XUI_SNI=www.cloudflare.com
# XUI_FP=safari
# XUI_FLOW=xtls-rprx-vision
#
# Сколько устройств может одновременно держать одну подписку (limitIp в 3x-ui).
# 1 = как у большинства сервисов, 0 = без лимита.
XUI_DEVICE_LIMIT=1
